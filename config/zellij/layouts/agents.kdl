// Host-wide agents window (`agents window`): one full-height list, no tab bar.
layout {
    default_tab_template {
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="agents" {
        pane command="bash" {
            args "-c" "exec \"$HOME/.dotfiles/bin/agents\" --all"
        }
    }
}
