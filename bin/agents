#!/usr/bin/env bash

# Manage agent CLIs (Claude, Codex, OpenCode, Agy) across zellij workspaces.

AGENT_RE='^(claude|claude\.exe|codex|opencode|agy)$'
BG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agents/bg"
ROWS_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/agents/rows"
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

usage() {
    cat <<'EOF'
usage: agents [--all | --workspace W]       fzf UI over running agents
       agents ls [--all | --workspace W] [--json]
       agents count [--workspace W]         one line for the zjstatus bar
       agents new [--workspace W] [--cwd DIR] [-- claude args...]
       agents window                        open the host-wide `agents` session
       agents hook-stop                     Claude Code Stop hook (stdin JSON)
       agents -h | --help

UI keys: enter jump, ctrl-x kill, ctrl-n new claude here, ctrl-r reload, ctrl-a all/workspace
EOF
}

usage_err() {
    usage >&2
    exit 2
}

die() {
    echo "agents: $*" >&2
    exit 1
}

# Workspace name for a dir, matching bin/zj; worktrees map to their main repo.
derive_ws() {
    local d="$1" common root="$1"
    common="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && [[ -n "$common" ]] && root="${common%/*}"
    root="${root##*/}"
    echo "${root//./}"
}

# One TSV row per running agent:
# workspace agent state bg pid age cwd pane session_id bg_id location
collect() {
    local tmp pids cwdpids ws agent state pid age cwd pane sid bgid loc bg
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/agents.XXXXXX")" || return 1

    ps -axo pid=,tty=,ucomm=,args= >"$tmp/ps" 2>/dev/null
    claude agents --json >"$tmp/json" 2>/dev/null || echo '[]' >"$tmp/json"

    # cand: pid agent state bg_id session_id cwd
    jq -r '.[]? | select(.pid != null) | [.pid, "claude",
        (if .status == "busy" then "working"
         elif .waitingFor == "permission prompt" then "permission"
         elif .status == "waiting" then "input"
         elif .status == "idle" then "idle"
         else "?" end),
        (if .kind == "background" then (.id // "-") else "-" end),
        (.sessionId // "-"), (.cwd // "-")] | @tsv' "$tmp/json" 2>/dev/null |
        while IFS=$'\t' read -r pid rest; do
            kill -0 "$pid" 2>/dev/null && printf '%s\t%s\n' "$pid" "$rest"
        done >"$tmp/cand"

    # The JSON misses some live ttys; add them from ps, skipping daemons and
    # pids the JSON already covers.
    cut -f1 "$tmp/cand" >"$tmp/seen"
    awk -v seenf="$tmp/seen" '
        BEGIN { OFS = "\t"; while ((getline l < seenf) > 0) seen[l] = 1 }
        {
            pid = $1; tty = $2; uc = $3
            args = $0; sub(/^ *[0-9]+ +[^ ]+ +[^ ]+ */, "", args)
            if (tty == "??" || (pid in seen)) next
            if (uc == "claude" || uc == "claude.exe") agent = "claude"
            else if (uc == "codex" || uc == "opencode" || uc == "agy") agent = uc
            else next
            if (args ~ /(^|\/)claude(\.exe)? (bg-pty-host|bg-spare|daemon)/ ||
                args ~ / daemon run/ || args ~ /opencode serve/ || args ~ /agy --hub/) next
            print pid, agent, (agent == "claude" ? "?" : "running"), "-", "-", "-"
        }' "$tmp/ps" >>"$tmp/cand"

    pids="$(cut -f1 "$tmp/cand" | paste -sd, -)"
    if [[ -z "$pids" ]]; then
        rm -rf "$tmp"
        return 0
    fi

    # Env holds the zellij session/pane; one batched call for all candidates.
    ps -E -o pid=,command= -p "$pids" 2>/dev/null | awk '
        BEGIN { OFS = "\t" }
        {
            s = "-"; p = "-"
            for (i = 2; i <= NF; i++) {
                if ($i ~ /^ZELLIJ_SESSION_NAME=/) { s = $i; sub(/^[^=]*=/, "", s) }
                else if ($i ~ /^ZELLIJ_PANE_ID=/) { p = $i; sub(/^[^=]*=/, "", p) }
            }
            print $1, s, p
        }' >"$tmp/env"

    ps -o pid=,etime= -p "$pids" 2>/dev/null | awk '
        BEGIN { OFS = "\t" }
        {
            e = $2; d = 0; h = 0
            if (e ~ /-/) { split(e, a, "-"); d = a[1]; e = a[2] }
            n = split(e, t, ":")
            if (n == 3) { h = t[1]; m = t[2]; s = t[3] } else { m = t[1]; s = t[2] }
            if (d > 0) r = d + 0 "d"; else if (h > 0) r = h + 0 "h"; else if (m > 0) r = m + 0 "m"; else r = s + 0 "s"
            print $1, r
        }' >"$tmp/age"

    # Claude rows carry their cwd; the rest need lsof (one batched call).
    cwdpids="$(awk -F'\t' '$6 == "-" { print $1 }' "$tmp/cand" | paste -sd, -)"
    : >"$tmp/cwd"
    if [[ -n "$cwdpids" ]]; then
        lsof -a -d cwd -p "$cwdpids" -Fpn 2>/dev/null | awk '
            BEGIN { OFS = "\t" }
            /^p/ { pid = substr($0, 2) }
            /^n/ { print pid, substr($0, 2) }' >"$tmp/cwd"
    fi

    awk -v envf="$tmp/env" -v agef="$tmp/age" -v cwdf="$tmp/cwd" '
        BEGIN {
            FS = OFS = "\t"
            while ((getline l < envf) > 0) { split(l, a, "\t"); ws[a[1]] = a[2]; pn[a[1]] = a[3] }
            while ((getline l < agef) > 0) { split(l, a, "\t"); age[a[1]] = a[2] }
            while ((getline l < cwdf) > 0) { split(l, a, "\t"); cw[a[1]] = a[2] }
        }
        {
            pid = $1
            c = ($6 != "-") ? $6 : ((pid in cw) ? cw[pid] : "-")
            print ((pid in ws) ? ws[pid] : "-"), $2, $3, pid, ((pid in age) ? age[pid] : "-"), c, ((pid in pn) ? pn[pid] : "-"), $5, $4
        }' "$tmp/cand" >"$tmp/joined"

    while IFS=$'\t' read -r ws agent state pid age cwd pane sid bgid; do
        if [[ "$ws" == "-" ]]; then
            ws="$(derive_ws "$cwd")"
            loc=outside
            pane=-
        else
            loc=zellij
            [[ "$pane" != "-" ]] && pane="terminal_$pane"
        fi
        bg=-
        if [[ "$sid" != "-" && -f "$BG_DIR/$sid" ]]; then
            read -r bg <"$BG_DIR/$sid"
            [[ "$bg" =~ ^[0-9]+$ ]] || bg=-
        fi
        [[ "$cwd" == "$HOME"* ]] && cwd="~${cwd#"$HOME"}"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$ws" "$agent" "$state" "$bg" "$pid" "$age" "$cwd" "$pane" "$sid" "$bgid" "$loc"
    done <"$tmp/joined"

    rm -rf "$tmp"
}

# collect, filtered to workspace $1 (empty = all), sorted by workspace then agent.
rows() {
    collect | LC_ALL=C sort -t $'\t' -k1,1 -k2,2 -k5,5n | awk -F'\t' -v w="$1" 'w == "" || $1 == w'
}

# collect, reused for a few seconds: every attached session's bar polls count,
# and one scan costs ~0.5s of CPU.
cached_rows() {
    local mtime tmp
    mtime="$(stat -f %m "$ROWS_CACHE" 2>/dev/null)" || mtime=0
    if (($(date +%s) - mtime >= 4)); then
        mkdir -p "${ROWS_CACHE%/*}" && chmod 700 "${ROWS_CACHE%/*}"
        tmp="$(mktemp "$ROWS_CACHE.XXXXXX")" && collect >"$tmp" && mv "$tmp" "$ROWS_CACHE"
    fi
    awk -F'\t' -v w="$1" 'w == "" || $1 == w' "$ROWS_CACHE"
}

# Pad the display columns. fzf mode appends the hidden fields used by actions:
# display ws agent pid cwd pane session_id bg_id location
render() {
    awk -F'\t' -v mode="$1" '
        function pad(s, n) { return sprintf("%-" n "s", s) }
        BEGIN {
            split("WORKSPACE AGENT STATE BG PID AGE", h, " ")
            for (i = 1; i <= 6; i++) w[i] = length(h[i])
        }
        {
            r[NR] = $0
            for (i = 1; i <= 6; i++) if (length($i) > w[i]) w[i] = length($i)
        }
        END {
            line = ""
            for (i = 1; i <= 6; i++) line = line pad(h[i], w[i]) "  "
            if (mode == "fzf") print line "CWD\t-\t-\t-\t-\t-\t-\t-\t-"; else print line "CWD"
            for (n = 1; n <= NR; n++) {
                split(r[n], f, "\t")
                line = ""
                for (i = 1; i <= 6; i++) line = line pad(f[i], w[i]) "  "
                line = line f[7]
                if (mode == "fzf") print line "\t" f[1] "\t" f[2] "\t" f[5] "\t" f[7] "\t" f[8] "\t" f[9] "\t" f[10] "\t" f[11]
                else print line
            }
        }'
}

# Scope flags -> ws_filter ("" = all); defaults to the current session.
parse_scope() {
    ws_filter="${ZELLIJ_SESSION_NAME:-}"
    want_json=0
    while (($#)); do
        case "$1" in
        --all) ws_filter="" ;;
        --workspace)
            [[ $# -ge 2 ]] || usage_err
            ws_filter="$2"
            shift
            ;;
        --json) want_json=1 ;;
        *) usage_err ;;
        esac
        shift
    done
}

cmd_ls() {
    parse_scope "$@"
    if ((want_json)); then
        rows "$ws_filter" | jq -Rn '[inputs | split("\t") | {
            workspace: .[0], agent: .[1], state: .[2], bg: .[3], pid: (.[4] | tonumber),
            age: .[5], cwd: .[6], pane: .[7], session_id: .[8], bg_id: .[9], location: .[10]}]'
    else
        rows "$ws_filter" | render plain
    fi
}

cmd_count() {
    {
        parse_scope "$@"
        cached_rows "$ws_filter" | awk -F'\t' '
            { n++; if ($3 == "permission" || $3 == "input") wait++; if ($4 ~ /^[0-9]+$/) bg += $4 }
            END {
                if (n == 0) exit
                out = "󰚩 " n
                if (wait > 0) out = out " · " wait " waiting"
                if (bg > 0) out = out " · " bg " bg"
                print out
            }'
    } 2>/dev/null
}

# Rows for the UI, scoped by the state file so the refresh loop follows ctrl-a.
cmd_rows() {
    local scope
    scope="$(cat "$1/scope" 2>/dev/null)"
    if [[ "$scope" == ws:* ]]; then
        rows "${scope#ws:}" | render fzf
    else
        rows "" | render fzf
    fi
}

cmd_toggle() {
    local scope home
    scope="$(cat "$1/scope" 2>/dev/null)"
    home="$(cat "$1/home" 2>/dev/null)"
    if [[ "$scope" == all && -n "$home" ]]; then
        echo "ws:$home" >"$1/scope"
    else
        echo all >"$1/scope"
    fi
}

cmd_jump() {
    local ws="$1" pane="$2" loc="$3" bg="$4" cwd="$5" pid="$6"
    [[ -n "$pid" ]] || return 0
    if [[ "$loc" == zellij ]]; then
        if [[ "$ws" == "${ZELLIJ_SESSION_NAME:-}" ]]; then
            zellij action focus-pane-id "$pane"
        else
            zellij action switch-session "$ws" --pane-id "$pane"
        fi
    elif [[ "$bg" != "-" ]]; then
        if [[ -n "$ZELLIJ" ]]; then
            zellij run --close-on-exit --name "claude-$bg" -- claude attach "$bg"
        else
            exec claude attach "$bg"
        fi
    else
        echo "not in zellij: $cwd (pid $pid)"
        read -rsn1 -p "press any key "
    fi
}

cmd_kill() {
    local agent="$1" pid="$2" ws="$3" bg="$4" reply uc
    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    read -r -p "kill $agent pid $pid in $ws? [y/N] " reply
    [[ "$reply" =~ ^[yY]$ ]] || return 0
    # Re-check the pid is still an agent: it may have exited and been reused.
    uc="$(ps -o ucomm= -p "$pid" 2>/dev/null | sed 's/^ *//;s/ *$//')"
    if ! [[ "$uc" =~ $AGENT_RE ]]; then
        echo "pid $pid is no longer an agent process"
        read -rsn1 -p "press any key "
        return 0
    fi
    if [[ "$agent" == claude && "$bg" != "-" ]]; then
        claude stop "$bg"
    else
        kill -TERM "$pid"
    fi
}

cmd_new() {
    local w="" cwd="" args
    while (($#)); do
        case "$1" in
        --workspace)
            [[ $# -ge 2 ]] || usage_err
            w="$2"
            shift 2
            ;;
        --cwd)
            [[ $# -ge 2 ]] || usage_err
            cwd="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *) usage_err ;;
        esac
    done
    [[ -z "$w" && -z "$ZELLIJ" ]] && die "not in zellij; pass --workspace"
    args=(zellij)
    [[ -n "$w" && "$w" != "${ZELLIJ_SESSION_NAME:-}" ]] && args+=(--session "$w")
    args+=(run --close-on-exit --name claude)
    [[ -n "$cwd" ]] && args+=(--cwd "$cwd")
    args+=(-- claude "$@")
    exec "${args[@]}"
}

cmd_new_from_row() {
    local ws="$1" cwd="$2"
    [[ -n "$ws" ]] || return 0
    # Rows show ~ for $HOME
    [[ "$cwd" == "~"* ]] && cwd="$HOME${cwd#\~}"
    "$self" new --workspace "$ws" --cwd "$cwd" || read -rsn1 -p "press any key "
}

cmd_window() {
    local running=0
    zellij list-sessions --short 2>/dev/null | grep -qx agents && running=1
    # The layout only seeds a new session; applied to a live one it adds tabs.
    if [[ -n "$ZELLIJ" ]]; then
        ((running)) && exec zellij action switch-session agents
        exec zellij action switch-session agents --layout agents
    fi
    ((running)) && exec zellij attach agents
    exec zellij --session agents --new-session-with-layout "$HOME/.config/zellij/layouts/agents.kdl"
}

# Records how many background tasks a session has; read back by `collect`.
cmd_hook_stop() {
    local input sid count tmp
    input="$(cat)"
    sid="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)"
    [[ "$sid" =~ ^[A-Za-z0-9-]+$ ]] || exit 0
    count="$(jq -r '.background_tasks | if type == "array" then length else 0 end' <<<"$input" 2>/dev/null)"
    [[ "$count" =~ ^[0-9]+$ ]] || count=0
    (
        umask 077
        mkdir -p "$BG_DIR" || exit 0
        tmp="$(mktemp "$BG_DIR/.tmp.XXXXXX")" || exit 0
        echo "$count" >"$tmp" && mv "$tmp" "$BG_DIR/$sid" || rm -f "$tmp"
    ) 2>/dev/null
    exit 0
}

cmd_ui() {
    parse_scope "$@"
    local tmp sock loop q_self q_scope close=""
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/agents-ui.XXXXXX")" || exit 1
    chmod 700 "$tmp"
    sock="$tmp/fzf.sock"
    echo "${ZELLIJ_SESSION_NAME:-$ws_filter}" >"$tmp/home"
    if [[ -n "$ws_filter" ]]; then echo "ws:$ws_filter" >"$tmp/scope"; else echo all >"$tmp/scope"; fi

    q_self="$(printf '%q' "$self")"
    q_scope="$(printf '%q' "$tmp")"

    # Refresh by pushing reload() to fzf's socket while it runs.
    (
        while sleep 2; do
            curl -s --max-time 1 --unix-socket "$sock" -XPOST http://localhost \
                -d "reload($q_self _rows $q_scope)" >/dev/null 2>&1
        done
    ) &
    loop=$!
    trap 'kill "$loop" 2>/dev/null; rm -rf "$tmp"' EXIT
    trap 'exit 130' INT TERM HUP

    # Inside the dedicated window the list stays open after a jump; elsewhere
    # (floating popup) it closes.
    [[ "${ZELLIJ_SESSION_NAME:-}" == agents ]] || close="+abort"

    "$self" _rows "$tmp" | fzf --listen="$sock" --delimiter=$'\t' --with-nth=1 \
        --header-lines=1 --layout=reverse --no-multi --prompt 'agents> ' \
        --preview-window=hidden \
        --bind "enter:execute($q_self _jump {2} {6} {9} {8} {5} {4})$close" \
        --bind "ctrl-x:execute($q_self _kill {3} {4} {2} {8})+reload($q_self _rows $q_scope)" \
        --bind "ctrl-n:execute($q_self _new-from-row {2} {5})+reload($q_self _rows $q_scope)" \
        --bind "ctrl-r:reload($q_self _rows $q_scope)" \
        --bind "ctrl-a:execute-silent($q_self _toggle $q_scope)+reload($q_self _rows $q_scope)"
}

case "${1:-}" in
-h | --help) usage ;;
ls)
    shift
    cmd_ls "$@"
    ;;
count)
    shift
    cmd_count "$@"
    ;;
new)
    shift
    cmd_new "$@"
    ;;
window) cmd_window ;;
hook-stop) cmd_hook_stop ;;
_rows) cmd_rows "$2" ;;
_toggle) cmd_toggle "$2" ;;
_jump) cmd_jump "$2" "$3" "$4" "$5" "$6" "$7" ;;
_kill) cmd_kill "$2" "$3" "$4" "$5" ;;
_new-from-row) cmd_new_from_row "$2" "$3" ;;
"" | --all | --workspace) cmd_ui "$@" ;;
*) usage_err ;;
esac
