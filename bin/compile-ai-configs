#!/usr/bin/env bash
# Compiles modular, tool-agnostic AI config fragments in ~/.dotfiles/ai/
# into tool-specific target files under ~/.dotfiles/link/.
#
# Each tool is one render() call listing an ordered set of blocks. A block is
# either a fragment name (a file in ai/) or a special directive:
#   laws     -> inline copy of the laws, for tools that don't do @-imports
# Add a tool by appending one render() call — no copy-paste blocks.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$BIN_DIR")"
AI="$DOTFILES_DIR/ai"
LINK="$DOTFILES_DIR/link"

echo "🔨 Compiling tool-agnostic AI configurations..."

# --- Laws: single source of truth -------------------------------------------
# Naminé is canonical for laws. ai/laws.md is the committed cache the non-Claude
# tools inline; refresh it from the global law notes when the namine CLI can
# reach its server, otherwise keep the committed copy.
# ai/guards.yaml is a committed copy of each global law's guards (slug: its guards list), so a
# guard edited by hand in `namine edit` can be diffed and restored from git.
refresh_laws_cache() {
  command -v namine >/dev/null 2>&1 || return 0
  local tmp tmp_guards slugs slug note; tmp="$(mktemp)"; tmp_guards="$(mktemp)"
  slugs="$(namine list --type law --binding global 2>/dev/null \
    | awk -F' *[|] *' 'NR > 1 { print $1 }')" || slugs=""
  if [[ -n "$slugs" ]]; then
    printf '<!-- markdownlint-disable MD041 -->\n' > "$tmp"
    printf '# Guards of the global laws, copied from Naminé by bin/compile-ai-configs. Edit them in Naminé.\n' > "$tmp_guards"
    for slug in $slugs; do
      # `namine show` prints YAML frontmatter, then the body.
      note="$(namine show "$slug")"
      awk '
        /^---$/ { n++; next }
        n == 1 && /^title: / { sub(/^title: /, ""); printf "\n### %s\n\n", $0 }
        n >= 2 { print }' <<<"$note" >> "$tmp"
      awk -v slug="$slug" '
        /^---$/ { n++; next }
        n == 1 && /^guards:/ { g = 1; printf "%s:\n", slug; next }
        n == 1 && g && /^[^ ]/ { g = 0 }
        n == 1 && g { print }' <<<"$note" >> "$tmp_guards"
    done
    if ! cmp -s "$tmp" "$AI/laws.md"; then
      cp "$tmp" "$AI/laws.md"
      echo "  - Refreshed ai/laws.md from Naminé"
    fi
    if ! cmp -s "$tmp_guards" "$AI/guards.yaml"; then
      cp "$tmp_guards" "$AI/guards.yaml"
      echo "  - Refreshed ai/guards.yaml from Naminé"
    fi
  fi
  rm -f "$tmp" "$tmp_guards"
}

# render <outfile> <title> <block>...
render() {
  local out="$1" title="$2"; shift 2
  {
    printf '%s\n\n' "$title"
    local first=1 blk
    for blk in "$@"; do
      [[ $first -eq 1 ]] || printf '\n'
      first=0
      case "$blk" in
        laws)    printf '## Laws (Mirroring Claude)\n'; cat "$AI/laws.md" ;;
        *)       cat "$AI/$blk.md" ;;
      esac
    done
  } > "$out"
  echo "  - Generated ${out#"$DOTFILES_DIR"/}"
}

mkdir -p "$LINK/.claude" "$LINK/.gemini" "$LINK/.antigravity" "$LINK/.qwen"
refresh_laws_cache

# Claude gets everything from Naminé (tier 1 at session start), so its file is
# only the pointer to it.
render "$LINK/.claude/CLAUDE.md" "# Claude — Global" namine

# Tools without @-import support get laws + user context inlined. Same payload
# as Claude otherwise — one shared block list keeps them from drifting.
for entry in \
  ".gemini/GEMINI.md|# Gemini — Mirroring Claude Global" \
  ".antigravity/ANTIGRAVITY.md|# Antigravity — Global" \
  ".qwen/QWEN.md|# Qwen — Global"; do
  IFS='|' read -r path title <<< "$entry"
  render "$LINK/$path" "$title" \
    persona principles memory_policy orchestration agents adr laws user_context
done

echo "✨ AI configurations compiled successfully!"
